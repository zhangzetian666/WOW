<Project Sdk="Microsoft.NET.Sdk">
  <!-- Full-sources harness: links one test file that owns Main, plus all src/*.cs. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>5</LangVersion>
    <AssemblyName>$(TestAsm)</AssemblyName>
    <StartupObject>$(TestMain)</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationManifest>..\src\app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <NoWarn>CS0618;CS0612;CS0219;CS0169;CS0414;CS0649</NoWarn>
    <Optimize>true</Optimize>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(TestAsm)\</OutputPath>
    <RootNamespace>WoWProbe</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\src\*.cs" />
    <Compile Include="$(TestExtra)" Condition="'$(TestExtra)' != ''" />
    <Compile Include="..\tests\$(TestName).cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
